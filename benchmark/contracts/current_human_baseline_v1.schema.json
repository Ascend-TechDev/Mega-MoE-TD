{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mega-moe-td:current-human-baseline:v1",
  "title": "Mega-MoE-TD current-human baseline receipt",
  "type": "object",
  "required": [
    "payload",
    "payload_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arm_id": {
      "type": "string",
      "enum": [
        "unfused_grouped_hccl_forward",
        "fused_current_main_forward",
        "backward_default_torch_wgrad",
        "backward_optin_triton_wgrad"
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "url",
        "commit",
        "tree"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "const": "https://gitcode.com/jzhoujg/Mega-MoE-TD.git"
        },
        "commit": {
          "const": "2887022970f6ae5c7ab5be096680809591100c30"
        },
        "tree": {
          "const": "2b5c447da8ff9ff788125aae5eec644579df105d"
        }
      }
    },
    "source_identity": {
      "type": "object",
      "required": [
        "kind",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["runtime_file", "gitlink"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "runtime_file"},
            "locator": {"pattern": "^/"}
          }
        },
        {
          "properties": {
            "kind": {"const": "gitlink"},
            "locator": {"const": "3rdparty/bigop"}
          }
        }
      ]
    },
    "component_identity": {
      "type": "object",
      "required": [
        "version",
        "source",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source_identity"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "repository",
        "variables",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "variables": {
          "const": {
            "MOE_FULL_BENCH_ROUTE_MODE": "dense_random",
            "MOE_FULL_BENCH_ACTIVE_EXPERTS": "8",
            "MOE_BWD_TRACE": ""
          }
        },
        "components": {
          "type": "object",
          "required": [
            "python",
            "torch",
            "torch_npu",
            "triton",
            "cann",
            "aclshmem",
            "bigop"
          ],
          "additionalProperties": false,
          "properties": {
            "python": {"$ref": "#/$defs/component_identity"},
            "torch": {"$ref": "#/$defs/component_identity"},
            "torch_npu": {"$ref": "#/$defs/component_identity"},
            "triton": {"$ref": "#/$defs/component_identity"},
            "cann": {"$ref": "#/$defs/component_identity"},
            "aclshmem": {"$ref": "#/$defs/component_identity"},
            "bigop": {"$ref": "#/$defs/component_identity"}
          }
        }
      }
    },
    "harness_identity": {
      "type": "object",
      "required": [
        "repository_url",
        "checkout_locator",
        "branch",
        "live_ref",
        "live_commit",
        "commit",
        "tree",
        "parents",
        "mount_identity",
        "product_base_commit",
        "product_base_tree",
        "changed_paths",
        "clean"
      ],
      "additionalProperties": false,
      "properties": {
        "repository_url": {"const": "https://gitcode.com/jzhoujg/Mega-MoE-TD.git"},
        "checkout_locator": {"type": "string", "pattern": "^/"},
        "branch": {"const": "codex02/uniep-current-main-recovery-20260809"},
        "live_ref": {"const": "refs/heads/codex02/uniep-current-main-recovery-20260809"},
        "live_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parents": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        },
        "mount_identity": {
          "type": "object",
          "required": ["mount_id", "parent_id", "device", "root", "mount_point"],
          "additionalProperties": false,
          "properties": {
            "mount_id": {"type": "integer", "minimum": 1},
            "parent_id": {"type": "integer", "minimum": 0},
            "device": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
            "root": {"type": "string", "pattern": "^/"},
            "mount_point": {"type": "string", "pattern": "^/"}
          }
        },
        "product_base_commit": {"const": "2887022970f6ae5c7ab5be096680809591100c30"},
        "product_base_tree": {"const": "2b5c447da8ff9ff788125aae5eec644579df105d"},
        "changed_paths": {
          "const": [
            "docs/design/HARNESS_DESIGN_PHILOSOPHY.md",
            "benchmark/contracts/current_human_baseline_v1.schema.json",
            "benchmark/baseline_contract.py",
            "benchmark/current_human_baseline.py",
            "benchmark/providers/current_main.py",
            "benchmark/providers/grouped_hccl.py",
            "scripts/architecture_lint.py",
            "tests/host/test_architecture_contract.py",
            "tests/host/test_baseline_contract.py",
            "tests/host/test_baseline_runner.py"
          ]
        },
        "clean": {"const": true}
      }
    },
    "sidecar_binding": {
      "const": {
        "algorithm": "sha256",
        "suffix": ".sha256",
        "required": true
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "contract_version",
        "repository",
        "submodules",
        "model",
        "parallel",
        "tokens_per_rank",
        "fixture_seed",
        "routing_environment",
        "timing",
        "arms",
        "arm_operations",
        "fusion_switches",
        "legal_comparisons",
        "precision",
        "providers",
        "raw_receipt"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": "current-human-baseline/v1"},
        "repository": {"$ref": "#/$defs/repository"},
        "submodules": {
          "const": [
            {"path": "3rdparty/bigop", "commit": "68ca4cb68dca41ca8960e6aedc38bd224b08a2af"}
          ]
        },
        "model": {"$ref": "#/$defs/model"},
        "parallel": {"const": {"expert_parallel_world_size": 2}},
        "tokens_per_rank": {"const": [4096, 8192, 16384]},
        "fixture_seed": {"const": 42},
        "routing_environment": {
          "const": {
            "MOE_FULL_BENCH_ROUTE_MODE": "dense_random",
            "MOE_FULL_BENCH_ACTIVE_EXPERTS": "8",
            "MOE_BWD_TRACE": ""
          }
        },
        "timing": {
          "const": {
            "warmup": 5,
            "samples": 50,
            "boundary": "synchronized full provider call; host wall-clock; per-sample rank MAX"
          }
        },
        "arms": {
          "const": [
            "unfused_grouped_hccl_forward",
            "fused_current_main_forward",
            "backward_default_torch_wgrad",
            "backward_optin_triton_wgrad"
          ]
        },
        "arm_operations": {
          "const": {
            "unfused_grouped_hccl_forward": "forward",
            "fused_current_main_forward": "forward",
            "backward_default_torch_wgrad": "backward",
            "backward_optin_triton_wgrad": "backward"
          }
        },
        "fusion_switches": {
          "const": {
            "unfused_grouped_hccl_forward": {
              "forward": "unfused_torch_npu_grouped_gemm_plus_hccl",
              "wgrad": "not_applicable"
            },
            "fused_current_main_forward": {
              "forward": "current_main_dispatch_fc1_weighted_swiglu_fc2_combine",
              "wgrad": "not_applicable"
            },
            "backward_default_torch_wgrad": {
              "forward": "not_timed",
              "wgrad": "torch_per_expert_default"
            },
            "backward_optin_triton_wgrad": {
              "forward": "not_timed",
              "wgrad": "triton_transposed_grouped_gemm_optin"
            }
          }
        },
        "legal_comparisons": {
          "const": [
            {
              "comparison_id": "forward_grouped_hccl_vs_fused",
              "baseline_arm": "unfused_grouped_hccl_forward",
              "candidate_arm": "fused_current_main_forward",
              "operation": "forward"
            },
            {
              "comparison_id": "backward_default_vs_triton_wgrad",
              "baseline_arm": "backward_default_torch_wgrad",
              "candidate_arm": "backward_optin_triton_wgrad",
              "operation": "backward"
            }
          ]
        },
        "precision": {
          "const": {
            "forward": ["full output"],
            "backward": [
              "grad_hidden",
              "grad_routing_weights",
              "grad_fc1_1",
              "grad_fc1_2",
              "grad_fc2"
            ],
            "timing_requires_precision_pass": true
          }
        },
        "providers": {
          "const": [
            {
              "provider_id": "current-main-grouped-hccl",
              "test_only": false,
              "arms": ["unfused_grouped_hccl_forward"],
              "source": {
                "repository_url": "https://gitcode.com/jzhoujg/Mega-MoE-TD.git",
                "commit": "2887022970f6ae5c7ab5be096680809591100c30",
                "tree": "2b5c447da8ff9ff788125aae5eec644579df105d",
                "paths": ["benchmark/layer/bench_full_forward.py"]
              },
              "entrypoint": "providers.grouped_hccl.execute_forward"
            },
            {
              "provider_id": "current-main-production",
              "test_only": false,
              "arms": [
                "fused_current_main_forward",
                "backward_default_torch_wgrad",
                "backward_optin_triton_wgrad"
              ],
              "source": {
                "repository_url": "https://gitcode.com/jzhoujg/Mega-MoE-TD.git",
                "commit": "2887022970f6ae5c7ab5be096680809591100c30",
                "tree": "2b5c447da8ff9ff788125aae5eec644579df105d",
                "paths": [
                  "src/mega_moe/ops/forward.py",
                  "src/mega_moe/ops/backward.py",
                  "src/mega_moe/kernels/dispatch_fc1.py",
                  "src/mega_moe/kernels/weighted_swiglu.py",
                  "src/mega_moe/kernels/fc2_combine.py"
                ]
              },
              "entrypoints": {
                "fused_current_main_forward": "providers.current_main.execute_forward",
                "backward_default_torch_wgrad": "providers.current_main.execute_backward",
                "backward_optin_triton_wgrad": "providers.current_main.execute_backward"
              }
            }
          ]
        },
        "raw_receipt": {
          "const": {
            "canonical_json": true,
            "full_sample_arrays": true,
            "payload_sha256": true,
            "file_sha256_sidecar": true
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "activation_dtype",
        "hidden",
        "ffn",
        "topk",
        "num_experts"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "Qwen3-30B-A3B"
        },
        "activation_dtype": {
          "const": "bfloat16"
        },
        "hidden": {
          "const": 2048
        },
        "ffn": {
          "const": 768
        },
        "topk": {
          "const": 8
        },
        "num_experts": {
          "const": 128
        }
      }
    },
    "shape_result": {
      "type": "object",
      "required": [
        "tokens_per_rank",
        "correctness",
        "samples_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens_per_rank": {
          "enum": [
            4096,
            8192,
            16384
          ]
        },
        "correctness": {
          "type": "object"
        },
        "samples_ms": {
          "type": "array",
          "minItems": 50,
          "maxItems": 50,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "arm_result": {
      "type": "object",
      "required": [
        "arm_id",
        "operation",
        "shapes"
      ],
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "$ref": "#/$defs/arm_id"
        },
        "operation": {
          "enum": [
            "forward",
            "backward"
          ]
        },
        "shapes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/shape_result"
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "status",
        "plan",
        "harness_identity",
        "sidecar_binding"
      ],
      "properties": {
        "contract_version": {
          "const": "current-human-baseline/v1"
        },
        "status": {
          "enum": [
            "DRY_RUN_VALIDATED",
            "COMPLETE"
          ]
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "harness_identity": {
          "$ref": "#/$defs/harness_identity"
        },
        "sidecar_binding": {
          "$ref": "#/$defs/sidecar_binding"
        },
        "arms": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/arm_result"
          }
        },
        "device_modules_loaded": {
          "type": "array",
          "maxItems": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETE"
              }
            }
          },
          "then": {
            "required": [
              "environment",
              "harness_identity",
              "sidecar_binding",
              "arms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DRY_RUN_VALIDATED"
              }
            }
          },
          "then": {
            "required": [
              "device_modules_loaded"
            ]
          }
        }
      ]
    }
  }
}
